{
	auto_https off
	servers {
		timeouts {
			read_body 30s
		}
	}
}

# Native routing example; all budgets below are EXAMPLES, not product defaults.
# Select budgets from upload sizes, engine limits and measured workload needs.
# APPSEC_API_KEY comes from the operator's environment; no real secret is here.
(combined) {
	trueops_appsec {
		waf on
		bot on
		endpoint http://127.0.0.1:7422/
		api_key {$APPSEC_API_KEY}
		timeout 2s
		max_body_bytes 10485760
		max_response_bytes 1048576
		max_in_flight 8
	}
}

http://site-a.test:8080 {
	# Host-wide companion route precedes every application/path exclusion.
	handle /crowdsec-internal/challenge/* {
		route {
			import combined
		}
	}
	# Excluding Bot on this path still requires a WAF-only native decision.
	handle /api/* {
		route {
			trueops_appsec {
				waf on
				bot off
				endpoint http://127.0.0.1:7423/
				api_key {$APPSEC_API_KEY}
				timeout 2s
				max_body_bytes 10485760
				max_response_bytes 1048576
				max_in_flight 8
			}
			respond "API origin"
		}
	}
	handle {
		route {
			import combined
			respond "Application origin"
		}
	}
}

http://site-b.test:8080 {
	route {
		trueops_appsec
		respond "Unprotected origin"
	}
}
