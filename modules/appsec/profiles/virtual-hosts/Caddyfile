{
	debug
	auto_https off
	servers {
		timeouts {
			read_body 30s
		}
	}
}

# Arguments: native endpoint, WAF flag, Bot flag. Budgets are deployment examples.
(inspection) {
	trueops_appsec {
		endpoint {args[0]}
		waf {args[1]}
		bot {args[2]}
		api_key {$APPSEC_API_KEY}
		timeout 2s
		max_body_bytes 10485760
		max_response_bytes 1048576
		max_in_flight 8
	}
}

# Application exclusions never take precedence over native challenge routes.
# A Bot exclusion selects WAF-only; a WAF exclusion selects Bot-only.
(site) {
	handle /crowdsec-internal/challenge/* {
		route {
			import inspection {args[0]} on on
		}
	}
	handle /off/* {
		respond "Unprotected origin"
	}
	handle /waf-only/* {
		route {
			import inspection {args[1]} on off
			respond "WAF-only origin"
		}
	}
	handle /bot-only/* {
		route {
			import inspection {args[2]} off on
			respond "Bot-only origin"
		}
	}
	handle {
		route {
			import inspection {args[0]} on on
			respond "Combined origin"
		}
	}
}

http://site-a.test:8080 {
	import site http://127.0.0.1:7423/ http://127.0.0.1:7422/ http://127.0.0.1:7424/
}

http://site-b.test:8080 {
	import site http://127.0.0.1:7426/ http://127.0.0.1:7425/ http://127.0.0.1:7427/
}
